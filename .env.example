# Local defaults
PORT=3000

# Behind a production reverse proxy, set the exact public origin, without a path.
# APP_ORIGIN=https://registry.example.org
# Trust only your proxy's exact address/subnet, never every incoming client.
# TRUST_PROXY=loopback

# PostgreSQL is required in development and production.
# Local example: postgres://mro:mro_local_password@127.0.0.1:5432/mro_registry
DATABASE_URL=postgres://mro:mro_local_password@127.0.0.1:5432/mro_registry
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# The attendance office geofence is stored in PostgreSQL and managed by an Admin
# from Office settings. It is not configured through environment variables.

# Used only by `npm run db:migrate:sqlite` for a one-time data import.
SQLITE_DATABASE_PATH=./submissions.db

# For hosted production, set NODE_ENV=production and use a long unique password.
# These values are only used to create the first account when the users table is empty.
INITIAL_ADMIN_NAME=MRO Administrator
INITIAL_ADMIN_EMAIL=admin@example.org
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
INITIAL_ADMIN_ROLE=admin
