{
    "name": "mon-refugee-org-membership",
    "version": "1.0.0",
    "main": "app-server.js",
    "scripts": {
        "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
        "dev:client": "vite",
        "dev:server": "NODE_ENV=development node --watch app-server.js",
        "build": "vite build",
        "test": "node --test tests/*.test.js",
        "start": "node app-server.js",
        "db:migrate:sqlite": "node scripts/migrate-sqlite-to-postgres.js",
        "admin:ensure": "node scripts/ensure-admin.js"
    },
    "dependencies": {
        "@google-cloud/local-auth": "^3.0.1",
        "dotenv": "^16.6.1",
        "exceljs": "^4.4.0",
        "express": "^4.22.2",
        "express-validator": "^7.3.2",
        "googleapis": "^176.0.0",
        "lucide-react": "^0.468.0",
        "morgan": "^1.11.0",
        "multer": "^2.2.0",
        "ogl": "^1.0.11",
        "pg": "^8.23.0",
        "puppeteer": "^25.9.0",
        "qrcode": "^1.5.4",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-router-dom": "^7.8.2",
        "unzipper": "^0.10.14"
    },
    "overrides": {
        "exceljs": { "uuid": "^11.1.1" },
        "gaxios": { "uuid": "^11.1.1" }
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.0.2",
        "concurrently": "^9.2.1",
        "sqlite3": "^6.0.1",
        "vite": "^7.1.3"
    }
}
